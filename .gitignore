# Generated by xcodegen from project.yml (R-13)
*.xcodeproj/
*.xcworkspace/

# Build output
DerivedData/
build/
.build/
*.xcresult
*.ipa
*.dSYM
*.dSYM.zip

# Local signing / team settings (R-14)
Config/Local.xcconfig
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
*.keychain

# Exports and artifacts (only the two committed samples are allowed)
exports/
artifacts/*
!artifacts/sample.mov
!artifacts/sample-frame.png

# macOS / Xcode user state
.DS_Store
xcuserdata/
*.xcuserstate
